# ==============================================================================
# AI TIMETABLE GENERATOR - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Port to run the Express Server (Hardcoded to port 3000 in AI Studio environments)
PORT=3000

# MongoDB Connection String
# For local development: "mongodb://localhost:27017/timetable-generator"
# For production (MongoDB Atlas): "mongodb+srv://<user>:<password>@cluster.mongodb.net/timetable"
# Note: If MONGODB_URI is left blank, empty, or fails to connect, the system will
# fallback automatically to an in-memory database server so you can test immediately.
MONGODB_URI="mongodb://localhost:27017/timetable-generator"

# JWT Authentication Configuration
# Set a strong, secure secret string for signing your tokens
JWT_SECRET="super-secure-dev-secret-change-this-in-production-123456"
# Token validity duration (e.g., "1d", "7d", "24h")
JWT_EXPIRES_IN="7d"

# Python AI API Endpoint URL
# The FastAPI / OR-Tools / Genetic Algorithm timetabling engine URL
# E.g., "http://localhost:8000/api/v1/generate"
PYTHON_AI_API_URL="http://localhost:8000/api/v1/generate"
